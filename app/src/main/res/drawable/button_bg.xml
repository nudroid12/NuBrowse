<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#34383D" />
            <stroke android:width="2dp" android:color="#9EC1FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2B3036" />
            <stroke android:width="2dp" android:color="#9EC1FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#202328" />
            <stroke android:width="1dp" android:color="#30343A" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
